# 复制为 .env；这个示例不含任何真实密钥。不要上传 .env。
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# 部署到服务器时必填。请使用至少12个字符的独立密码，不要填ChatGPT密码。
APP_PASSWORD=
# 对外访问的完整地址（部署时填写，用于安全检查）；本机运行可留空。
PUBLIC_URL=
# 使用支持 Chat Completions 的服务。先填供应商官方API地址和模型名，再填自己的API Key。
# 示例地址：https://api.deepseek.com/v1；其他供应商请使用其官方地址。
# Base URL 必须是HTTPS；密钥只会发送到你配置的这一服务。
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_MAX_TOKENS=2200
# 默认关闭；启用后可能产生所选AI供应商的API费用。
AUTO_UPDATE_ENABLED=false
DAILY_COUNT=4
UPDATE_HOUR=8
UPDATE_TIMEZONE=Asia/Shanghai
# 默认先生成待确认的草稿。true表示自动发布通过原文比对的草稿，仍不能保证解读无误。
AUTO_PUBLISH=false
